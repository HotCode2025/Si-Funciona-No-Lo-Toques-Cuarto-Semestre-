# URL pública del servicio de IA (carpeta /ia). Sin esto, la app funciona pero sin análisis de fotos.
# En el APK tiene que ser https y accesible desde el celular.
VITE_IA_URL=
# URL pública del sitio, sin barra final (ej. https://oceanos.vercel.app). La necesita la vista previa al compartir por WhatsApp.
VITE_SITE_URL=
