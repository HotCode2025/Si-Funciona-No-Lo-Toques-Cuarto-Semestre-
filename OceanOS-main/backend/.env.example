# Copiá este archivo a .env y ajustá los valores.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Conexión a PostgreSQL 18 (funciona de 16 en adelante)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/oceanos

# Secreto de firma del JWT. En producción generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame_en_produccion_0123456789abcdef0123456789abcdef

# Origen del frontend (Vite)
CORS_ORIGIN=http://localhost:5173
