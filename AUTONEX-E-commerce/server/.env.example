# ------------------------------------------------------------------ AUTONEX · server/.env
# Copiá este archivo como server/.env y completá los valores.

# Servidor HTTP
PORT=3200
HOST=127.0.0.1
NODE_ENV=development

# Prefijo de la app cuando corre detrás de un proxy en una subruta (ej: /autonex).
# Dejalo vacío para servir en la raíz.
BASE_PATH=

# PostgreSQL
#   Con usuario y contraseña:  postgresql://autonex:autonex@localhost:5432/autonex
#   Por socket local (peer):   postgresql:///autonex?host=/var/run/postgresql
DATABASE_URL=postgresql://autonex:autonex@localhost:5432/autonex

# JWT: usá una cadena larga y aleatoria (por ejemplo: openssl rand -hex 32)
JWT_SECRET=cambiame-por-una-cadena-larga-y-aleatoria
JWT_EXPIRA=7d

# URL pública desde la que el comprador ve la tienda (sin barra final).
# Se usa para armar las back_urls de Mercado Pago.
#   Desarrollo con Vite:   http://localhost:5173
#   Producción en subruta: https://midominio.com.ar/autonex
PUBLIC_URL=http://localhost:5173

# URL pública del backend para el webhook de Mercado Pago (por ejemplo la de ngrok).
# Si queda vacía se usa PUBLIC_URL. Con localhost no se envía notification_url.
WEBHOOK_BASE_URL=

# true = Fastify sirve también el frontend compilado (client/dist). Útil en producción.
SERVE_FRONTEND=false

# ------------------------------------------------------------------ Mercado Pago (Checkout Pro)
# Access Token de PRUEBA de tu aplicación (Tus integraciones > Credenciales de prueba).
# Va SOLO acá, nunca en el frontend.
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones > Webhooks). Opcional: si está, se valida la firma x-signature.
MP_WEBHOOK_SECRET=

# Titular del sitio: se muestra en el pie y en los términos y condiciones (Ley 24.240). Si quedan vacíos, no se muestran.
OPERADOR_RAZON_SOCIAL=
OPERADOR_CUIT=
OPERADOR_DOMICILIO=
OPERADOR_EMAIL=

# Mails: confirmación de email, comprobante de compra, recuperación de contraseña y reintegros.
# Opción 1 (tiene prioridad), SMTP de Gmail: llega a cualquier dirección sin dominio propio. En la cuenta de Google:
# verificación en 2 pasos activada y una "contraseña de aplicación" (myaccount.google.com/apppasswords) en SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opción 2, Resend (resend.com): para mandar a cualquier dirección necesita un dominio verificado.
RESEND_API_KEY=
# Remitente. Con SMTP puede quedar vacío (se usa "AUTONEX <SMTP_USER>"). Con Resend sin dominio verificado:
# "AUTONEX <onboarding@resend.dev>" (solo llega al email de la cuenta de Resend). Sin ninguna opción, los mails no se
# envían (quedan en el log). Para probar: npm run mail:probar -- tu@email.com
MAIL_FROM=
# A dónde llegan las respuestas a los mails (opcional)
MAIL_REPLY_TO=
# Contraseña de las cuentas de demo que crea el seed (administrador, comprador y vendedores), mínimo 8 caracteres.
# No se publica: cada uno elige la suya.
SEED_PASSWORD=
# Cuentas nuevas: hasta confirmar el email no pueden ingresar y el local del vendedor no se publica (false lo desactiva)
EXIGIR_EMAIL_CONFIRMADO=true
