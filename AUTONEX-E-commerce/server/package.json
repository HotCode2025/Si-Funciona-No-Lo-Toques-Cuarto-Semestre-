{
  "name": "autonex-server",
  "version": "2.0.0",
  "private": true,
  "description": "API de AUTONEX (Fastify + PostgreSQL + Mercado Pago)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch-path=src src/index.js",
    "start": "node src/index.js",
    "db:migrar": "node db/migrar.js",
    "db:seed": "node db/seed.js",
    "importar": "node scripts/importar.js",
    "dnrpa": "node scripts/dnrpa/etl-dnrpa.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "imagenes": "node scripts/descargar-imagenes.js",
    "creditos": "node scripts/generar-creditos.js",
    "logos": "node scripts/generar-logos-vendedores.js",
    "logos:marcas": "node scripts/logos-marcas.js",
    "imagenes:carpeta": "node scripts/carpeta-imagenes.js",
    "motos:wikidata": "node scripts/motos/wikidata-motos.js",
    "mail:probar": "node scripts/probar-mail.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.4",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.0",
    "bcrypt": "^6.0.0",
    "csv-parse": "^5.6.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.5.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "mercadopago": "^2.3.0",
    "nodemailer": "10.0.13",
    "pg": "^8.13.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "yauzl": "^3.2.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
