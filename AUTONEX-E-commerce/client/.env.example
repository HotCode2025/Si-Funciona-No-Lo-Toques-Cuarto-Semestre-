# ------------------------------------------------------------------ AUTONEX · client/.env
# Copiá este archivo como client/.env si necesitás cambiar algo. El frontend NO lleva credenciales:
# el access token de Mercado Pago vive solo en server/.env.

# Subruta donde se publica la app (con barra al final). "/" para la raíz.
# Tiene que coincidir con BASE_PATH de server/.env (ej: VITE_BASE_PATH=/autonex/ y BASE_PATH=/autonex).
VITE_BASE_PATH=/

# A dónde reenvía /api el servidor de desarrollo de Vite.
VITE_API_PROXY=http://127.0.0.1:3200
